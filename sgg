-- 🔒 BLOCKED ZONES (POLICE)
local BLOCKED_ZONES = {
    { pos = Vector3.new(-1451, 255, -3133), radius = 500 },
}

local function isBlocked(pos)
    for _, z in ipairs(BLOCKED_ZONES) do
        if (pos - z.pos).Magnitude <= z.radius then
            return true
        end
    end
    return false
end

-- 🔍 PROMPT HELPERS
local function getPromptPart(prompt)
    local parent = prompt.Parent
    if parent:IsA("BasePart") then return parent end
    return parent:FindFirstChildWhichIsA("BasePart", true)
end

local function getAllItems(name)
    local results = {}
    for _, obj in ipairs(workspace.GUNS:GetDescendants()) do
        if obj.Name == name then
            table.insert(results, obj)
        end
    end
    return results
end

local function getValidPrompt(name)
    local valid = {}

    for _, item in ipairs(getAllItems(name)) do
        for _, obj in ipairs(item:GetDescendants()) do
            if obj:IsA("ProximityPrompt") and obj.Name == "BuyPrompt" then
                local part = getPromptPart(obj)

                -- 🔥 FILTER HERE (not later)
                if part and not isBlocked(part.Position) then
                    table.insert(valid, {prompt = obj, part = part})
                end
            end
        end
    end

    if #valid == 0 then return nil end

    local hrp = getHRP().Position
    table.sort(valid, function(a, b)
        return (a.part.Position - hrp).Magnitude < (b.part.Position - hrp).Magnitude
    end)

    return valid[1]
end

