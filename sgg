end

local function findPlayerByText(input)
    if not input or input == "" then return nil end

    local search = normalize(input)
    local bestMatch = nil

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local username = normalize(plr.Name)
            local displayname = normalize(plr.DisplayName)

            if username == search or displayname == search then
                return plr
            end

            if username:sub(1, #search) == search or displayname:sub(1, #search) == search then
                bestMatch = plr
            elseif username:find(search, 1, true) or displayname:find(search, 1, true) then
                bestMatch = plr
            end
        end
    end

    return bestMatch
end

local function findPlayerByPartialName(name)
    name = tostring(name):lower()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr.Name:lower():sub(1, #name) == name or (plr.DisplayName and plr.DisplayName:lower():sub(1, #name) == name) then
            return plr
        end
    end
    return nil
end

