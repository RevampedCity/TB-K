            teleport(-1217, 254, -3637)

            -- Wait a limited time for the money bag to appear.
            local waitStart = os.clock()
            repeat
                task.wait(0.5)
            until hasBag() or os.clock() - waitStart >= 60

            local bag = hasBag()
            if not bag then
                showGui("BagOfMoney did not appear. Wash step timed out.", Color3.fromRGB(200, 0, 0))
                return
            end

            local humanoid = getHumanoid()
            if bag:IsA("Tool") then
                humanoid:EquipTool(bag)
            end

            -- Bank location used by the existing money-washing flow.
            teleport(-224, 284, -1201)
            task.wait(0.5)

            local bankStart = os.clock()
            while hasBag() and os.clock() - bankStart < 30 do
                local prompt = closestPrompt(30)
                if prompt and typeof(fireproximityprompt) == "function" then
                    pcall(function()
                        fireproximityprompt(prompt, 0)
                    end)
                end
                task.wait(0.25)
            end

            if not hasBag() then
                showGui("Wash Money attempt finished. Check your cash/inventory.", Color3.fromRGB(0, 170, 80))
            else
                showGui("Bag is still in your inventory. Check the bank prompt.", Color3.fromRGB(200, 120, 0))
            end
        end)

        if not ok then
            warn("Wash Money failed: " .. tostring(err))
            showGui("Wash Money failed. Check the console.", Color3.fromRGB(200, 0, 0))
        end
    end
})

