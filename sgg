local function GetSafe()
    local safe = nil

    pcall(function()
        local doorSS = workspace:WaitForChild("HomeDoorSS", 3)
        local homeDoor = doorSS and doorSS:WaitForChild("HomeDoor", 3)
        safe = homeDoor and homeDoor:WaitForChild("Safe", 3)
    end)

    if not safe then
        pcall(function()
            local map = workspace:FindFirstChild("1# Map")
            local crosswalks = map and map:FindFirstChild("2 Crosswalks")
            local safes = crosswalks and crosswalks:FindFirstChild("Safes")
            if safes then
                for _, v in ipairs(safes:GetChildren()) do
                    local part = v:FindFirstChild("Union") or v:FindFirstChildWhichIsA("BasePart")
                    if part then
                        safe = v
                        break
                    end
                end
            end
        end)
    end

    return safe
end

