utilitySection:Toggle({
    Text = "C Delete",
    Description = "Deletes objects you click while holding C, restores on untoggle",
    Default = false,

    Callback = function(state)
        if state then
            deletedParts = {}

            if cDeleteConnection then
                cDeleteConnection:Disconnect()
            end

            cDeleteConnection = mouse.Button1Down:Connect(function()
                if not UserInputService:IsKeyDown(Enum.KeyCode.C) then return end

                local target = mouse.Target
                if target and target:IsA("BasePart") then
                    local clone = target:Clone()
                    local parent = target.Parent

                    table.insert(deletedParts, {
                        Clone = clone,
                        Parent = parent
                    })

                    target:Destroy()
                end
            end)
        else
            if cDeleteConnection then
                cDeleteConnection:Disconnect()
                cDeleteConnection = nil
            end

            for _, data in ipairs(deletedParts) do
                if data.Clone and data.Parent then
                    data.Clone.Parent = data.Parent
                end
            end

            deletedParts = {}
        end
    end
})
