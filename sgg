local safeDupeBusy = false
local autoSafeDupeEnabled = false

local function runSafeDupe(showMessages)
    if safeDupeBusy then
        return false, "A safe operation is already running."
    end

    local character = getCharacter()
    local tool = character and character:FindFirstChildOfClass("Tool")
    if not tool then
        return false, "Equip the item you want to process first."
    end

    local toolName = tool.Name
    local safe = GetSafe()
    if not safe then
        return false, "Safe not found!"
    end

    local inventoryRemote = ReplicatedStorage:FindFirstChild("Inventory")
    local backpackRemote = ReplicatedStorage:FindFirstChild("BackpackRemote")
    if not inventoryRemote or not backpackRemote then
        return false, "Required inventory remotes were not found."
    end

    safeDupeBusy = true
    local ok, err = pcall(function()
        pcall(function()
            character:WaitForChild("Humanoid"):UnequipTools()
        end)
        backpackRemote:InvokeServer("Store", toolName)
        inventoryRemote:FireServer("Change", toolName, "Backpack", safe)
        task.wait(2)
        backpackRemote:InvokeServer("Grab", toolName)
    end)
    safeDupeBusy = false

    if not ok then
        warn("Safe operation failed:", err)
        return false, "Safe operation failed; check the console."
    end

    return true, "Safe requests sent for " .. toolName .. ". Verify your inventory."
end

